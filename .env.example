# 独立4v4网站使用自己的数据库，不读取或连接VolleyBoard的数据库。
FOUR_V_FOUR_DATABASE_URL="file:./data/four-v-four.db"
# 独立Turso/libSQL数据库：
# FOUR_V_FOUR_DATABASE_URL="libsql://your-4v4-database.turso.io"
# FOUR_V_FOUR_AUTH_TOKEN=""
# 空库首次生成管理员访问码：npm run staff:access -- admin
# 登录 /manage 初始化后，再设置两片场地访问码（或已初始化库用 staff:access -- all）。
# FOUR_V_FOUR_SESSION_SECRET="至少32字符的独立随机密钥"
# 生产部署应设置正式 HTTPS 站点地址，并通过 HTTPS 使用管理入口。
# FOUR_V_FOUR_SITE_ORIGIN="https://your-4v4-site.example"
# Workers构建及运行需为cloudflare，普通本地/Node运行留空或设node。
# FOUR_V_FOUR_DEPLOY_TARGET="cloudflare"
# 正式生产：数据库使用持久磁盘绝对路径；云库必须独立并先完成专用测试库验证。
# 维护命令先设置 NODE_ENV=production，读取顺序与 Next 生产模式一致。
# FOUR_V_FOUR_DATABASE_URL="file:/srv/volley-4v4-data/event.db"
# 禁止将密钥、令牌或数据库地址放到 NEXT_PUBLIC_*。
# FOUR_V_FOUR_ALLOW_LOCAL_HTTP=1 仅限本机测试，正式生产不得启用。
